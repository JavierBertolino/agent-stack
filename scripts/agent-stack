#!/usr/bin/env sh
# agent-stack — global entry point written by install.sh --global.
# Installed into <prefix>/bin with <prefix>/share/agent-stack baked in as
# the kit root. Runs with the current directory as the project root, so
# from any project directory: agent-stack init --platforms opencode
set -eu

SHARE="@SHARE@"

usage() {
  cat <<'EOF'
Usage:
  agent-stack init [options]       Scaffold and render missing files.
  agent-stack sync [options]       Render missing or managed files.
  agent-stack check [options]      Fail when generated files drift.
  agent-stack adopt                Import existing OpenCode role prompts.
  agent-stack prune                Remove only safe, stale generated files.
  agent-stack doctor [options]     Dependencies, skills, governance, policy.
  agent-stack upgrade [--check]    Safe three-way migration to a newer kit.
  agent-stack run-state ...        Validated run state (see run-state --help).
  agent-stack validate ...         Validate contract JSON (see validate --help).
  agent-stack --version            Print the installed kit version.

Options after the subcommand are passed through, e.g.
agent-stack init --platforms opencode,claude --mcp linear.
The project root defaults to the current directory; override any
subcommand's root with --root PATH.
EOF
}

die() {
  printf '%s\n' "agent-stack: $*" >&2
  exit 2
}

[ -d "$SHARE" ] || die "kit directory missing: $SHARE (re-run install.sh --global)"

command=${1:-}
[ "$#" -gt 0 ] && shift

case "$command" in
  init|sync|check|adopt|prune)
    exec sh "$SHARE/scripts/setup-agent-stack.sh" "$command" \
      --root "$PWD" --kit-root "$SHARE" "$@"
    ;;
  doctor)
    exec sh "$SHARE/scripts/doctor.sh" \
      --root "$PWD" --kit-root "$SHARE" "$@"
    ;;
  upgrade)
    exec sh "$SHARE/scripts/upgrade-agent-stack.sh" \
      --root "$PWD" --kit-root "$SHARE" "$@"
    ;;
  run-state)
    exec python3 "$SHARE/scripts/run-state.py" --root "$PWD" "$@"
    ;;
  validate)
    exec python3 "$SHARE/scripts/validate-contracts.py" --kit-root "$SHARE" "$@"
    ;;
  --version|-v)
    awk -F= '$1 == "AGENT_STACK_VERSION" { print $2; exit }' \
      "$SHARE/.agent-stack/defaults.conf"
    ;;
  ''|-h|--help)
    usage
    ;;
  *)
    die "unknown subcommand: $command (see agent-stack --help)"
    ;;
esac
