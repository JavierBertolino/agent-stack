#!/usr/bin/env sh
# Short alias for the agent-stack setup script.
#   as init | sync | check | adopt | prune | auth jev [--validate-only]
# Forwards all args; resolves the kit root from this file's location.
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
KIT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
exec sh "$SCRIPT_DIR/setup-agent-stack.sh" --kit-root "$KIT_ROOT" "$@"
